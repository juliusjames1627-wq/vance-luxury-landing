# Bolt / Supabase (see https://support.bolt.new/integrations/supabase)
# Table `public.leads` with column `payload jsonb not null` (+ RLS allowing anon insert if calling from the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Bolt server function, automation webhook, or other HTTPS ingest
VITE_LEADS_WEBHOOK_URL=

# Canonical site URL for Open Graph (defaults to https://elenavance.com in index.html)
VITE_SITE_URL=https://elenavance.com
